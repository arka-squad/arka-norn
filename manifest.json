{
  "$schema": "manifest.json",
  "schemaVersion": 3,
  "name": "arka-norn",
  "version": "2.3.4",
  "description": "Local live framing, Project tracking, signed evidence and auditable delivery orchestration.",
  "locales": {
    "canonical": "en",
    "supported": [
      "en",
      "fr"
    ],
    "fallback": "en",
    "preference": "$ARKA_NORN_HOME/.arka-norn/preferences.json"
  },
  "domain": {
    "relation": "Project -> Framing Plan -> Feature -> Lot -> Pipeline/Run",
    "projectMarker": ".arka-norn/project.json",
    "featureMarker": ".arka-norn/feature.json",
    "agentRegistry": ".arka-norn/agents.json",
    "vocabulary": "docs/domain/vocabulary.md"
  },
  "contracts": {
    "pipeline": "pipeline.json",
    "pipelineCatalog": "pipelines/catalog.json",
    "framingPlan": "schemas/framing-plan.schema.json",
    "framingDelta": "schemas/framing-delta.schema.json",
    "repositoryProbe": "schemas/repository-probe.schema.json",
    "essentialPipeline": "pipelines/arka-norn-essential.json",
    "fastdevPipeline": "pipelines/arka-norn-fastdev.json",
    "legacyContracts": "schemas/legacy/fr/",
    "schemas": "schemas/",
    "userGuide": "docs/user-guide.md",
    "developerGuide": "docs/developer-guide.md",
    "essentialGuide": "docs/essential.md",
    "agentGuide": "docs/agent-guide.md",
    "auditDomains": "docs/audit/domains.md",
    "auditSecurity": "docs/audit/security.md",
    "webGuide": "docs/web.md",
    "adrs": [
      "docs/adr/ADR-001-canonical-project.md",
      "docs/adr/ADR-002-sources-of-truth.md",
      "docs/adr/ADR-003-versioning-and-migrations.md",
      "docs/adr/ADR-004-cli-contract.md",
      "docs/adr/ADR-005-agent-registry.md",
      "docs/adr/ADR-006-project-audit-v5.md"
    ]
  },
  "cli": {
    "version": "arka-norn --version | arka-norn -v",
    "tui": "arka-norn",
    "locale": "arka-norn locale <show|set auto|en|fr>",
    "project": "arka-norn project <list|add|import|scan|show|use|forget|reconcile>",
    "feature": "arka-norn feature <list|create|import|scan|show|use|forget|reconcile|set-workflow>",
    "framing": "arka-norn framing <enter|show|resume|list>",
    "agent": "arka-norn agent <list|register|show|current|use|sessions|advise|prompt|handoff-prompt|deactivate|replace>",
    "pipeline": "arka-norn pipeline <status|next|scaffold|validate>",
    "workflow": "arka-norn workflow <list|show>",
    "essential": "arka-norn essential <start|status|next>",
    "fastdev": "arka-norn fastdev <start|status|next>",
    "audit": "arka-norn audit <inspect|prepare|start|status|submit|finalize|cancel|resume|list|show|compare|kb|evidence|export|tools>",
    "skills": "arka-norn skills <list|install|doctor>",
    "migrate": "arka-norn migrate [--target <path>] [--dry-run|--apply]",
    "doctor": "arka-norn doctor [--repair [--apply]]",
    "selftest": "arka-norn selftest",
    "web": "arka-norn web <start|stop|restart|status|foreground> [--port <port>] [--no-open] [--json]"
  },
  "quality": {
    "gate": "npm run check",
    "typecheck": "npm run typecheck",
    "maxSourceLines": 700,
    "tests": [
      "npm run test:unit",
      "npm run test:integration",
      "npm run test:e2e"
    ]
  },
  "distribution": {
    "privateInputExcluded": ".input/",
    "publicDocumentationLocale": "en",
    "webAssets": "dist/web/"
  },
  "rules": [
    "English is canonical for code, identifiers, contracts, commands and public documentation.",
    "Human display text follows the active EN/FR locale; machine data never changes with locale.",
    "New Features use Essential by default; existing legacy Features retain their explicit contract until migration.",
    "Portable markers are sources of truth and local indexes are reconstructible caches.",
    "Every v5 document declares content_locale and a verified author_agent_id.",
    "Generated skills and Web catalogs come from canonical sources and are never copied manually.",
    "The Web interface observes orchestration; Agent control remains in native provider applications.",
    "No source file may exceed 700 lines."
  ]
}
