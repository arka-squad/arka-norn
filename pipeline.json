{
  "$id": "pipeline.json",
  "schemaVersion": 3,
  "pipelineId": "arka-norn-complete",
  "version": "2.0.0",
  "name": "Complete",
  "description": "Full ten-step workflow for structural, uncertain or migration-heavy Features.",
  "steps": [
    {
      "id": "concept",
      "decisionGate": "human_decision",
      "order": 1,
      "schema": "schemas/concept.schema.json",
      "required": true,
      "multiple": false,
      "dependsOn": []
    },
    {
      "id": "plan",
      "decisionGate": "human_decision",
      "order": 2,
      "schema": "schemas/plan.schema.json",
      "required": true,
      "multiple": false,
      "dependsOn": [
        "concept"
      ]
    },
    {
      "id": "technical_contract_appendix",
      "decisionGate": "continue",
      "order": 3,
      "schema": "schemas/technical-contract-appendix.schema.json",
      "required": false,
      "multiple": false,
      "dependsOn": [
        "plan"
      ]
    },
    {
      "id": "current_state_audit",
      "decisionGate": "continue",
      "order": 4,
      "schema": "schemas/current-state-audit.schema.json",
      "required": true,
      "multiple": false,
      "dependsOn": [
        "plan"
      ]
    },
    {
      "id": "frozen_invariants",
      "decisionGate": "continue",
      "order": 5,
      "schema": "schemas/frozen-invariants.schema.json",
      "required": true,
      "multiple": false,
      "dependsOn": [
        "current_state_audit"
      ]
    },
    {
      "id": "debt_register",
      "decisionGate": "continue",
      "order": 6,
      "schema": "schemas/debt-register.schema.json",
      "required": true,
      "multiple": false,
      "dependsOn": [
        "frozen_invariants"
      ]
    },
    {
      "id": "agent_task",
      "decisionGate": "continue",
      "order": 7,
      "schema": "schemas/agent-task.schema.json",
      "required": true,
      "multiple": true,
      "dependsOn": [
        "debt_register"
      ]
    },
    {
      "id": "technical_integration_specification",
      "decisionGate": "continue",
      "order": 8,
      "schema": "schemas/technical-integration-specification.schema.json",
      "required": true,
      "multiple": false,
      "dependsOn": [
        "agent_task"
      ]
    },
    {
      "id": "development_report",
      "decisionGate": "continue",
      "order": 9,
      "schema": "schemas/development-report.schema.json",
      "required": true,
      "multiple": true,
      "dependsOn": [
        "technical_integration_specification"
      ],
      "businessPolicy": {
        "type": "delivery",
        "verdictField": "status",
        "passValues": [
          "delivered"
        ],
        "inProgressValues": [
          "partial"
        ]
      }
    },
    {
      "id": "qa_review",
      "decisionGate": "human_decision",
      "order": 10,
      "schema": "schemas/qa-review.schema.json",
      "required": true,
      "multiple": true,
      "dependsOn": [
        "development_report"
      ],
      "loopTo": "development_report",
      "businessPolicy": {
        "type": "review_latest",
        "targetStep": "development_report",
        "targetDocumentField": "development_report_id",
        "verdictField": "overall_status",
        "passValues": [
          "pass"
        ],
        "failValues": [
          "fail"
        ],
        "inProgressValues": [
          "partial"
        ],
        "retryStep": "development_report"
      }
    }
  ],
  "transversal": {
    "handoff": {
      "schema": "schemas/handoff.schema.json",
      "description": "Optional handoff between agents or providers."
    }
  },
  "definitionOfDone": "Every required document validates, every dependency resolves and the latest delivery review passes."
}
