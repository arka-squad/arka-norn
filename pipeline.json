{
  "$id": "pipeline.json",
  "schemaVersion": 2,
  "pipelineId": "arka-norn-default",
  "version": "2.0.0",
  "description": "Définition machine-lisible du cycle de vie d'une feature. N'importe quel agent (Claude Code, Codex CLI, Antigravity, autre) doit produire les mêmes types de documents JSON, validables mécaniquement, quel que soit celui qui exécute une étape.",
  "steps": [
    {
      "id": "concept",
      "ordre": 1,
      "schema": "schemas/concept.schema.json",
      "obligatoire": true,
      "multiple": false,
      "depend_de": []
    },
    {
      "id": "plan",
      "ordre": 2,
      "schema": "schemas/plan.schema.json",
      "obligatoire": true,
      "multiple": false,
      "depend_de": ["concept"]
    },
    {
      "id": "annexe_contrat_technique",
      "ordre": 3,
      "schema": "schemas/annexe-contrat-technique.schema.json",
      "obligatoire": false,
      "multiple": false,
      "depend_de": ["plan"]
    },
    {
      "id": "audit_etat_reel",
      "ordre": 4,
      "schema": "schemas/audit-etat-reel.schema.json",
      "obligatoire": true,
      "multiple": false,
      "depend_de": ["plan"]
    },
    {
      "id": "invariants_figes",
      "ordre": 5,
      "schema": "schemas/invariants-figes.schema.json",
      "obligatoire": true,
      "multiple": false,
      "depend_de": ["audit_etat_reel"]
    },
    {
      "id": "registre_dettes",
      "ordre": 6,
      "schema": "schemas/registre-dettes.schema.json",
      "obligatoire": true,
      "multiple": false,
      "depend_de": ["invariants_figes"]
    },
    {
      "id": "tache_agent",
      "ordre": 7,
      "schema": "schemas/tache-agent.schema.json",
      "obligatoire": true,
      "multiple": true,
      "depend_de": ["registre_dettes"]
    },
    {
      "id": "spec_integration_technique",
      "ordre": 8,
      "schema": "schemas/spec-integration-technique.schema.json",
      "obligatoire": true,
      "multiple": false,
      "depend_de": ["tache_agent"]
    },
    {
      "id": "cr_dev",
      "ordre": 9,
      "schema": "schemas/cr-dev.schema.json",
      "obligatoire": true,
      "multiple": true,
      "depend_de": ["spec_integration_technique"]
    },
    {
      "id": "recette_qa",
      "ordre": 10,
      "schema": "schemas/recette-qa.schema.json",
      "obligatoire": true,
      "multiple": true,
      "depend_de": ["cr_dev"],
      "peut_boucler_vers": "cr_dev"
    }
  ],
  "transversal": {
    "handoff": {
      "schema": "schemas/handoff.schema.json",
      "description": "Utilisable à toute étape pour transmettre un état de travail d'un agent/provider à un autre, sans dépendre de leur présence simultanée."
    }
  },
  "definition_of_done": {
    "regle": "Une étape n'est 'fini' que si le fichier JSON correspondant valide son schema ET que ses dépendances (depend_de) sont elles-mêmes valides. 'recette_qa' n'est fini que si statut_global vaut 'pass' pour au moins une exécution rattachée au dernier cr_dev valide.",
    "interdits": [
      "marquer une étape faite si son fichier JSON ne valide pas son schema",
      "sauter une étape obligatoire (obligatoire: true) même si l'agent estime que c'est trivial",
      "modifier un fichier JSON déjà produit par un autre agent sans passer par un handoff qui documente pourquoi"
    ]
  }
}
