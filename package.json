{
  "name": "arka-norn",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arka-squad/arka-norn.git"
  },
  "bugs": {
    "url": "https://github.com/arka-squad/arka-norn/issues"
  },
  "homepage": "https://github.com/arka-squad/arka-norn#readme",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/",
    "examples/",
    "schemas/",
    "pipelines/",
    "skills-src/",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "manifest.json",
    "pipeline.json"
  ],
  "type": "module",
  "description": "Local multi-provider cockpit for repository discovery, verified Features, Agents, evidence and auditable delivery workflows.",
  "bin": {
    "arka-norn": "bin/arka-norn.mjs"
  },
  "scripts": {
    "build": "node scripts/generate-v2-skills.mjs && node scripts/clean-dist.mjs && tsc && node scripts/generate-v2-examples.mjs && node scripts/generate-web-catalogs.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "check:js-syntax": "node tests/lint.mjs",
    "check:max-lines": "node scripts/check-max-lines.mjs",
    "check:language": "node scripts/check-language.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "node tests/run-tests.mjs",
    "test:unit": "node tests/run-tests.mjs unit",
    "test:integration": "node tests/run-tests.mjs integration",
    "test:e2e": "node tests/run-tests.mjs e2e",
    "test:coverage": "c8 --all --include \"src/**/*.ts\" --exclude \"src/ports/**\" --exclude \"src/**/_shared/*-deps.ts\" --exclude \"src/domain/pipeline/pipeline-report.ts\" --reporter=text --reporter=json-summary --check-coverage --lines 70 --functions 70 --branches 60 npm test",
    "test:coverage:cli": "c8 --all --include \"src/adapters/inbound/cli/**/*.ts\" --reporter=text --reporter=json-summary --check-coverage --lines 70 --functions 70 --branches 60 npm run test:unit",
    "smoke:mastra": "node scripts/mastra-smoke.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "check": "npm run check:max-lines && npm run check:language && npm run lint && npm run selftest",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "install-skills": "node bin/arka-norn.mjs install",
    "status": "node bin/arka-norn.mjs status",
    "scaffold": "node bin/arka-norn.mjs scaffold",
    "validate": "node bin/arka-norn.mjs validate",
    "selftest": "node bin/arka-norn.mjs selftest",
    "doctor": "node bin/arka-norn.mjs doctor",
    "skills": "node bin/arka-norn.mjs skills list",
    "audit:dependencies": "node scripts/audit-gate.mjs --omit=dev && node scripts/audit-gate.mjs",
    "release:verify": "npm run check && npm run test:coverage && npm run test:coverage:cli && npm run benchmark && npm run audit:dependencies && npm pack --dry-run --ignore-scripts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.145",
    "@mastra/acp": "0.4.0",
    "@mastra/claude": "0.3.0",
    "@mastra/core": "1.55.0",
    "ajv": "^8.17.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "c8": "^11.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
