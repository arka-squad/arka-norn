{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "development-report.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "document-envelope.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "schema_version",
    "id",
    "feature_id",
    "type",
    "sequence",
    "created_at",
    "ref",
    "date",
    "agent",
    "spec_sources",
    "status",
    "delivered_files",
    "covered_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "id": {
      "type": "string"
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "development_report"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "ref": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      }
    },
    "spec_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "delivered",
        "partial",
        "blocked"
      ]
    },
    "delivered_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action",
          "lines",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "created",
              "modified",
              "deleted"
            ]
          },
          "lines": {
            "type": "integer"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "covered_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement",
          "covered",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          },
          "covered": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "corrections_applied": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_document_id",
          "finding_id",
          "action",
          "evidence"
        ],
        "properties": {
          "source_document_id": {
            "type": "string",
            "minLength": 1
          },
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "title": "Development Report"
}
