{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature-marker.schema.json",
  "title": "Marker Feature arka-norn v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "projectId", "name", "root", "pipelineId", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "root": { "type": "string", "minLength": 1, "pattern": "^(?:/|[A-Za-z]:[\\\\/])" },
    "pipelineId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
