{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestration-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "selectionMode",
    "providers",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "selectionMode": {
      "enum": [
        "assisted",
        "best"
      ]
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "adapter",
        "enabled",
        "priority",
        "capabilities",
        "permissions",
        "models"
      ],
      "properties": {
        "provider": {
          "enum": [
            "claude",
            "codex",
            "kimi",
            "zai"
          ]
        },
        "adapter": {
          "enum": [
            "claude-cli",
            "codex-cli",
            "claude-sdk",
            "acp"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "inspect_workspace",
              "modify_workspace",
              "run_commands",
              "read_pipeline"
            ]
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read_workspace",
              "write_workspace",
              "shell",
              "network"
            ]
          }
        },
        "models": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "claude"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "adapter": {
                "const": "claude-cli"
              }
            },
            "required": [
              "adapter"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "codex"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "adapter": {
                "const": "codex-cli"
              }
            },
            "required": [
              "adapter"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "zai"
              }
            },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "adapter": {
                "const": "claude-sdk"
              }
            },
            "required": ["adapter"]
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "kimi"
              }
            },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "adapter": {
                "const": "acp"
              }
            },
            "required": ["adapter"]
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  },
  "title": "Orchestration Policy"
}
