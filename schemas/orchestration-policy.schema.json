{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestration-policy.schema.json",
  "title": "Politique d'orchestration d'un Project arka-norn",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "providers", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/provider" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "enabled", "priority", "capabilities", "permissions"],
      "properties": {
        "provider": { "enum": ["claude", "codex"] },
        "enabled": { "type": "boolean" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["inspect_workspace", "modify_workspace", "run_commands", "read_pipeline"] }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["read_workspace", "write_workspace", "shell", "network"] }
        }
      }
    }
  }
}
