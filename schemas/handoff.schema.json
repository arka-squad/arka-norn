{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "document-envelope.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "id",
    "type",
    "ref",
    "date",
    "sender_agent",
    "recipient_agent",
    "message_type",
    "subject",
    "pipeline_step",
    "current_state",
    "completed_work",
    "remaining_work",
    "blockers",
    "reference_files"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "handoff"
    },
    "ref": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "sender_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      }
    },
    "recipient_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      }
    },
    "message_type": {
      "type": "string",
      "enum": [
        "handoff",
        "verdict",
        "ack",
        "question",
        "blocker"
      ]
    },
    "subject": {
      "type": "string"
    },
    "pipeline_step": {
      "type": "string",
      "enum": [
        "concept",
        "plan",
        "technical_contract_appendix",
        "current_state_audit",
        "frozen_invariants",
        "debt_register",
        "agent_task",
        "technical_integration_specification",
        "development_report",
        "qa_review",
        "transversal"
      ]
    },
    "current_state": {
      "type": "string"
    },
    "completed_work": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining_work": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "required_decision"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "required_decision": {
            "type": "string"
          }
        }
      }
    },
    "reference_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "title": "Handoff"
}
