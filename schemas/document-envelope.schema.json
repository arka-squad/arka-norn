{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-envelope.schema.json",
  "title": "Enveloppe commune des documents arka-norn",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "feature_id",
    "type",
    "sequence",
    "created_at",
    "depends_on_document_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 2,
      "description": "Version commune du contrat documentaire."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
      "description": "Identifiant globalement unique dans la Feature."
    },
    "feature_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifiant de la Feature propriétaire."
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Type machine-lisible du document."
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Séquence monotone au sein d'un même type documentaire."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Instant de création déterministe."
    },
    "depends_on_document_ids": {
      "type": "array",
      "uniqueItems": true,
      "description": "Identifiants exacts des documents dont celui-ci dépend.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
