{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "updatedAt",
    "agents"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "role",
          "active",
          "scope",
          "registeredAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9-]{0,39}_[a-z][a-z0-9-]{0,39}_[0-9]{8}(?:_[0-9]{2})?$"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "active": {
            "type": "boolean"
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "projectId",
              "featureIds",
              "paths",
              "responsibilities"
            ],
            "properties": {
              "projectId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "featureIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                }
              },
              "paths": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "responsibilities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deactivatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "replacedByAgentId": {
            "type": "string"
          },
          "replacesAgentId": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "active": {
                  "const": false
                }
              },
              "required": [
                "active"
              ]
            },
            "then": {
              "required": [
                "deactivatedAt"
              ]
            }
          }
        ]
      }
    }
  },
  "title": "Agent Registry"
}
