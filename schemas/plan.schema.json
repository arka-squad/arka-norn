{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "document-envelope.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "version",
    "target",
    "source_concepts",
    "nature",
    "completion_criteria",
    "guiding_principle",
    "assertion_status",
    "batches",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "plan"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "source_concepts": {
      "type": "array",
      "minItems": 1,
      "default": [
        "TO_FILL"
      ],
      "items": {
        "type": "string"
      }
    },
    "nature": {
      "type": "string"
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "default": [
        "TO_FILL"
      ],
      "items": {
        "type": "string"
      }
    },
    "guiding_principle": {
      "type": "string"
    },
    "assertion_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locked",
        "objective_to_prove"
      ],
      "properties": {
        "locked": {
          "type": "array",
          "default": [
            "TO_FILL"
          ],
          "items": {
            "type": "string"
          }
        },
        "objective_to_prove": {
          "type": "array",
          "default": [
            "TO_FILL"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "valid",
        "obsolete"
      ]
    },
    "scope_model": {
      "type": "string"
    },
    "technical_stack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "title": "Plan"
}
