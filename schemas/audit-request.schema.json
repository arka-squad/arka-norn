{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "mode",
    "paths",
    "modules",
    "sources",
    "capabilities"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "mode": {
      "enum": [
        "discovery",
        "audit",
        "mixed"
      ]
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moduleId",
          "intent",
          "depth",
          "criteria"
        ],
        "properties": {
          "moduleId": {
            "enum": [
              "M01",
              "M02",
              "M03",
              "M04",
              "M05",
              "M06",
              "M07",
              "M08",
              "M09",
              "M10",
              "M11"
            ]
          },
          "intent": {
            "enum": [
              "discover",
              "audit"
            ]
          },
          "depth": {
            "enum": [
              "inventory",
              "static",
              "connected",
              "dynamic"
            ]
          },
          "criteria": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "urls"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "urls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowImagePulls",
        "allowedHosts",
        "credentialRefs",
        "dynamicTargets"
      ],
      "properties": {
        "allowImagePulls": {
          "type": "boolean"
        },
        "allowedHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          }
        },
        "credentialRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        },
        "dynamicTargets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        }
      }
    }
  },
  "title": "Audit Request"
}
