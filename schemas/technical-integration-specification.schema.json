{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technical-integration-specification.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "document-envelope.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "covered_batches",
    "sources",
    "frozen_decisions",
    "date",
    "nature",
    "structure",
    "contracts",
    "invariant_references"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "technical_integration_specification"
    },
    "title": {
      "type": "string"
    },
    "covered_batches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "frozen_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "date": {
      "type": "string"
    },
    "nature": {
      "type": "string"
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crates",
        "adapters"
      ],
      "properties": {
        "crates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adapters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "definition"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        }
      }
    },
    "invariant_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "title": "Technical Integration Specification"
}
