{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "document-envelope.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "version",
    "date",
    "scope",
    "objective",
    "assumptions",
    "executive_summary",
    "guiding_principle",
    "sections",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "concept"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "default": [
        {
          "subject": "TO_FILL",
          "selected_position": "TO_FILL"
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "selected_position"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "selected_position": {
            "type": "string"
          }
        }
      }
    },
    "executive_summary": {
      "type": "string"
    },
    "guiding_principle": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "content"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "valid",
        "obsolete"
      ]
    },
    "recommendation": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "title": "Concept"
}
