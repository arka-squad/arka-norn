{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-validation.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "document-envelope.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "schema_version",
    "author_agent_id",
    "id",
    "feature_id",
    "type",
    "sequence",
    "created_at",
    "depends_on_document_ids",
    "development_report_id",
    "verified_criteria",
    "verified_corrections",
    "technical_gates",
    "functional_evidence",
    "ux_evidence",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "author_agent_id": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "feature_id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "delivery_validation",
        "delivery_validation"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "depends_on_document_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "development_report_id": {
      "type": "string",
      "minLength": 1
    },
    "delivery_audit_id": {
      "type": "string",
      "minLength": 1
    },
    "verified_criteria": {
      "$ref": "#/$defs/controles"
    },
    "verified_corrections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controle"
      }
    },
    "technical_gates": {
      "$ref": "#/$defs/controles"
    },
    "functional_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ux_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "partial"
      ]
    }
  },
  "$defs": {
    "controles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/controle"
      }
    },
    "controle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "non_applicable"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "title": "Delivery Validation"
}
