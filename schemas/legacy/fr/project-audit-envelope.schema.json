{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-audit-envelope.schema.json",
  "title": "Enveloppe v4 des audits Project arka-norn",
  "description": "Contrat dédié aux audits d'un Project entier. Il ne remplace pas l'enveloppe Feature v2/v3.",
  "type": "object",
  "required": [
    "schema_version",
    "author_agent_id",
    "id",
    "project_id",
    "type",
    "sequence",
    "created_at",
    "depends_on_document_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 4,
      "description": "Version réservée aux audits Project."
    },
    "author_agent_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9-]{0,39}_[a-z][a-z0-9-]{0,39}_[0-9]{8}(?:_[0-9]{2})?$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Identifiant du Project audité."
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "depends_on_document_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
