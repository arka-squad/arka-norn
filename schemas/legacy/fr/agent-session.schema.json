{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-session.schema.json",
  "title": "Sélections Agent isolées par session provider",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "selectedBySession"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "selectedBySession": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9-]{0,39}_[a-z][a-z0-9-]{0,39}_[0-9]{8}(?:_[0-9]{2})?$"
        }
      }
    }
  }
}
