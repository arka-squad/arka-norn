{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cadrage-essentiel.schema.json",
  "title": "Cadrage d'une Feature Essentiel",
  "description": "Document racine du pipeline arka-norn-essentiel. Il fusionne l'intention (concept), le découpage (plan + tâches) et les critères d'acceptation prouvables dans un seul document signé, sans dupliquer le cadrage FastDev : il ajoute l'objectif de valeur, les lots, et des champs optionnels de décisions et d'invariants.",
  "type": "object",
  "allOf": [{ "$ref": "document-envelope.schema.json" }],
  "unevaluatedProperties": false,
  "required": [
    "schema_version", "author_agent_id", "id", "feature_id", "type", "sequence", "created_at", "depends_on_document_ids",
    "probleme", "objectif", "resultat_attendu", "perimetre", "zones_impactees", "lots",
    "criteres_acceptation", "tests_attendus", "risques", "definition_de_fini"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "author_agent_id": { "type": "string" },
    "id": { "type": "string" },
    "feature_id": { "type": "string" },
    "type": { "const": "cadrage_essentiel" },
    "sequence": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "depends_on_document_ids": { "type": "array", "maxItems": 0 },
    "probleme": { "type": "string", "minLength": 1 },
    "objectif": { "type": "string", "minLength": 1, "description": "Objectif de valeur en une ou deux phrases : ce que la Feature change pour ses destinataires, pas comment." },
    "resultat_attendu": { "type": "string", "minLength": 1 },
    "perimetre": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inclus", "exclus"],
      "properties": {
        "inclus": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exclus": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "zones_impactees": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "lots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "titre", "depend_de"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "titre": { "type": "string", "minLength": 1 },
          "depend_de": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }, "description": "Ids d'autres lots qui doivent être livrés avant celui-ci." }
        }
      }
    },
    "criteres_acceptation": {
      "type": "array",
      "minItems": 4,
      "description": "Au moins un critère par dimension canonique : code, fonctionnel, ux et securite.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "critere", "preuve_attendue"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "dimension": { "enum": ["code", "fonctionnel", "ux", "securite"] },
          "critere": { "type": "string", "minLength": 1 },
          "preuve_attendue": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        { "contains": { "type": "object", "properties": { "dimension": { "const": "code" } }, "required": ["dimension"] } },
        { "contains": { "type": "object", "properties": { "dimension": { "const": "fonctionnel" } }, "required": ["dimension"] } },
        { "contains": { "type": "object", "properties": { "dimension": { "const": "ux" } }, "required": ["dimension"] } },
        { "contains": { "type": "object", "properties": { "dimension": { "const": "securite" } }, "required": ["dimension"] } }
      ]
    },
    "tests_attendus": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "risques": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "risque", "mitigation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "risque": { "type": "string", "minLength": 1 },
          "mitigation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "definition_de_fini": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "decisions": {
      "type": "array",
      "description": "Arbitrages tranchés pendant le cadrage, pour la traçabilité sans registre séparé.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sujet", "decision"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "sujet": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 },
          "justification": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invariants": {
      "type": "array",
      "description": "Règles non négociables découvertes pendant le cadrage et imposées à la livraison.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enonce"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "enonce": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
