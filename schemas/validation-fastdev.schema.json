{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-fastdev.schema.json",
  "title": "Validation finale FastDev",
  "type": "object",
  "allOf": [{ "$ref": "document-envelope.schema.json" }],
  "unevaluatedProperties": false,
  "required": [
    "schema_version", "author_agent_id", "id", "feature_id", "type", "sequence", "created_at", "depends_on_document_ids",
    "cr_dev_id", "audit_rework_id", "criteres_verifies", "corrections_controlees", "gates_techniques",
    "preuves_fonctionnelles", "preuves_ux", "verdict"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "author_agent_id": { "type": "string" },
    "id": { "type": "string" },
    "feature_id": { "type": "string" },
    "type": { "const": "validation_fastdev" },
    "sequence": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "depends_on_document_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "cr_dev_id": { "type": "string", "minLength": 1 },
    "audit_rework_id": { "type": "string", "minLength": 1 },
    "criteres_verifies": { "$ref": "#/$defs/controles" },
    "corrections_controlees": { "type": "array", "items": { "$ref": "#/$defs/controle" } },
    "gates_techniques": { "$ref": "#/$defs/controles" },
    "preuves_fonctionnelles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "preuves_ux": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "verdict": { "enum": ["pass", "fail", "partial"] }
  },
  "$defs": {
    "controles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/controle" }
    },
    "controle": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statut", "preuve"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statut": { "enum": ["pass", "fail", "non_applicable"] },
          "preuve": { "type": "string", "minLength": 1 }
        }
    }
  }
}
