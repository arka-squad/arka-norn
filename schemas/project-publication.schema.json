{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arka-norn.local/schemas/project-publication.schema.json",
  "title": "Project publication journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "projectId", "framingId", "planId", "planRevision", "planFingerprint", "root", "rootFingerprint", "relativePlanPath", "state", "createdAt", "updatedAt", "error"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "framingId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "planId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "planRevision": { "type": "integer", "minimum": 1 },
    "planFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "rootFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePlanPath": { "type": "string", "pattern": "^\\.arka-norn/plans/[A-Za-z0-9._:-]+/[0-9]{8}-[a-f0-9]{64}\\.json$" },
    "state": { "enum": ["prepared", "staged", "plan_committed", "marker_committed", "indexed", "materialized"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
            "message": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      ]
    }
  }
}
