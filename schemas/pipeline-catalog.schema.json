{
  "$id": "pipeline-catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline catalog",
  "description": "Catalog of Norn delivery pipelines.",
  "type": "object",
  "required": ["schemaVersion", "pipelines"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [2, 3]
    },
    "defaultPipelineId": {
      "type": "string",
      "description": "Legacy v2 default pipeline id. Required when schemaVersion is 2."
    },
    "newFeatureEntry": {
      "type": "string",
      "enum": ["framing_required"],
      "description": "Required when schemaVersion is 3. New Features must enter through a published framing plan."
    },
    "compatibilityFallbackPipelineId": {
      "type": "string",
      "description": "Required when schemaVersion is 3. Fallback pipeline for legacy compatibility only."
    },
    "pipelines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "aliases", "name", "description", "definition"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "generation": {
            "type": "string",
            "enum": ["2.3", "legacy"],
            "description": "Required when schemaVersion is 3."
          },
          "availability": {
            "type": "string",
            "enum": ["framing_calculated", "existing_only", "explicit_rework"],
            "description": "Required when schemaVersion is 3."
          },
          "aliases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "definition": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "if": { "properties": { "schemaVersion": { "const": 3 } } },
  "then": { "required": ["newFeatureEntry", "compatibilityFallbackPipelineId"] },
  "else": { "required": ["defaultPipelineId"] }
}
