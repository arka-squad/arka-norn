{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-review.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "document-envelope.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "schema_version",
    "id",
    "feature_id",
    "type",
    "sequence",
    "created_at",
    "development_report_id",
    "ref",
    "date",
    "tester",
    "environment",
    "version",
    "overall_status",
    "scope",
    "prerequisites",
    "test_cases"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "id": {
      "type": "string"
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "qa_review"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "development_report_id": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "tester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "partial"
      ]
    },
    "scope": {
      "type": "string"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "steps",
          "expected_outcome",
          "actual_result",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_outcome": {
            "type": "string"
          },
          "actual_result": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "partial",
              "skip"
            ]
          }
        }
      }
    }
  },
  "title": "Qa Review"
}
