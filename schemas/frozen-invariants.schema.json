{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frozen-invariants.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "document-envelope.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "frozen_invariants"
    },
    "task_id": {
      "type": "string"
    },
    "plan_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date": {
      "type": "string"
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "N1",
              "N2"
            ]
          },
          "source_section": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "level",
          "source_section"
        ]
      }
    }
  },
  "required": [
    "id",
    "type",
    "task_id",
    "plan_sources",
    "depends_on",
    "date",
    "invariants"
  ],
  "title": "Frozen Invariants"
}
